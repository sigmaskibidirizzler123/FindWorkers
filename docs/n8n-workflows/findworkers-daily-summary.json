{
    "name": "FindWorkers - Daily Summary Report",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 21,
                            "triggerAtMinute": 0
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "⏰ Daily 9PM",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.FINDWORKERS_API_URL || 'https://find-workers.vercel.app' }}/api/webhooks/n8n",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "x-webhook-secret",
                            "value": "={{ $env.WEBHOOK_SECRET }}"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "action",
                            "value": "daily_summary"
                        }
                    ]
                },
                "jsonBody": "{\"action\": \"daily_summary\"}"
            },
            "id": "fetch-summary",
            "name": "📊 Fetch Daily Summary",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "message",
                            "value": "={{ $json.data.message }}"
                        }
                    ]
                }
            },
            "id": "format-summary",
            "name": "📝 Format Summary",
            "type": "n8n-nodes-base.set",
            "typeVersion": 1,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "chatId": "YOUR_TELEGRAM_CHAT_ID",
                "text": "={{ $json.message }}",
                "additionalFields": {}
            },
            "id": "telegram-summary",
            "name": "📱 Send to Telegram",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1,
            "position": [
                950,
                300
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
                    "name": "Telegram Bot"
                }
            }
        }
    ],
    "connections": {
        "⏰ Daily 9PM": {
            "main": [
                [
                    {
                        "node": "📊 Fetch Daily Summary",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "📊 Fetch Daily Summary": {
            "main": [
                [
                    {
                        "node": "📝 Format Summary",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "📝 Format Summary": {
            "main": [
                [
                    {
                        "node": "📱 Send to Telegram",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}