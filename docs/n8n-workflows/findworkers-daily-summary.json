{
    "name": "FindWorkers - Daily Summary Report (Discord)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 21,
                            "triggerAtMinute": 0
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "⏰ Daily 9PM",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.FINDWORKERS_API_URL || 'https://find-workers.vercel.app' }}/api/webhooks/n8n",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "x-webhook-secret",
                            "value": "={{ $env.WEBHOOK_SECRET }}"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\"action\": \"daily_summary\"}"
            },
            "id": "fetch-summary",
            "name": "📊 Fetch Daily Summary",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ username: 'FindWorkers Daily Report', avatar_url: 'https://cdn-icons-png.flaticon.com/512/2920/2920686.png', embeds: [{ title: '📊 Báo Cáo Ngày ' + ($json.data?.date || new Date().toISOString().split('T')[0]), color: 5793266, fields: [ { name: '📋 Đơn ứng tuyển', value: String($json.data?.totalApplications || 0), inline: true }, { name: '💼 Tin tuyển dụng mới', value: String($json.data?.totalNewJobs || 0), inline: true }, { name: '🏢 Doanh nghiệp mới', value: String($json.data?.totalNewEmployers || 0), inline: true }, { name: '👤 Ứng viên mới', value: String($json.data?.totalNewCandidates || 0), inline: true }, { name: '✅ Đã tuyển', value: String($json.data?.hiredToday || 0), inline: true } ], timestamp: new Date().toISOString(), footer: { text: 'FindWorkers Daily Summary' } }] }) }}"
            },
            "id": "discord-summary",
            "name": "💬 Send to Discord",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                750,
                300
            ]
        }
    ],
    "connections": {
        "⏰ Daily 9PM": {
            "main": [
                [
                    {
                        "node": "📊 Fetch Daily Summary",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "📊 Fetch Daily Summary": {
            "main": [
                [
                    {
                        "node": "💬 Send to Discord",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}