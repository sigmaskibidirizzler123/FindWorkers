{
    "name": "FindWorkers - Real-time Notifications (Discord)",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "findworkers-events",
                "responseMode": "onReceived",
                "responseCode": 200
            },
            "id": "webhook-trigger",
            "name": "🔔 Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.event }}",
                            "operation": "contains",
                            "value2": "application"
                        }
                    ]
                }
            },
            "id": "if-application",
            "name": "📋 Is Application?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                200
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.event }}",
                            "operation": "contains",
                            "value2": "employer"
                        }
                    ]
                }
            },
            "id": "if-employer",
            "name": "🏢 Is Employer?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                500
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.event }}",
                            "operation": "contains",
                            "value2": "system"
                        }
                    ]
                }
            },
            "id": "if-system",
            "name": "🚨 Is System Alert?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                800
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ username: 'FindWorkers Bot', avatar_url: 'https://cdn-icons-png.flaticon.com/512/3135/3135692.png', embeds: [{ title: '🔥 Ứng Viên Mới Apply!', description: $json.data.message || 'New application received', color: 16744448, fields: [ { name: '👤 Ứng viên', value: $json.data.candidateName || 'N/A', inline: true }, { name: '💼 Vị trí', value: $json.data.jobTitle || 'N/A', inline: true }, { name: '📱 SĐT', value: $json.data.candidatePhone || 'N/A', inline: true }, { name: '🏢 Doanh nghiệp', value: $json.data.employerName || 'N/A', inline: true } ], timestamp: $json.timestamp, footer: { text: 'FindWorkers Alert System' } }] }) }}"
            },
            "id": "discord-application",
            "name": "💬 Discord (Application)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                750,
                200
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ username: 'FindWorkers Bot', avatar_url: 'https://cdn-icons-png.flaticon.com/512/3135/3135692.png', embeds: [{ title: '🏢 Doanh Nghiệp Mới!', description: $json.data.message || 'New employer registered', color: 3447003, fields: [ { name: '🏪 Tên DN', value: $json.data.businessName || 'N/A', inline: true }, { name: '📱 SĐT', value: $json.data.phone || 'N/A', inline: true }, { name: '📍 Địa chỉ', value: $json.data.location || 'N/A', inline: true } ], timestamp: $json.timestamp, footer: { text: 'FindWorkers Alert System' } }] }) }}"
            },
            "id": "discord-employer",
            "name": "💬 Discord (Employer)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                750,
                500
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ username: 'FindWorkers ALERT', avatar_url: 'https://cdn-icons-png.flaticon.com/512/564/564619.png', content: '@everyone', embeds: [{ title: '🚨 System Alert!', description: $json.data.message || 'System error detected', color: 15158332, fields: [ { name: '📌 Type', value: $json.data.errorType || $json.event, inline: true }, { name: '⚠️ Severity', value: $json.data.severity || 'unknown', inline: true } ], timestamp: $json.timestamp, footer: { text: 'FindWorkers Alert System' } }] }) }}"
            },
            "id": "discord-system",
            "name": "💬 Discord (System Alert)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                750,
                800
            ]
        }
    ],
    "connections": {
        "🔔 Webhook Trigger": {
            "main": [
                [
                    {
                        "node": "📋 Is Application?",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "🏢 Is Employer?",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "🚨 Is System Alert?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "📋 Is Application?": {
            "main": [
                [
                    {
                        "node": "💬 Discord (Application)",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "🏢 Is Employer?": {
            "main": [
                [
                    {
                        "node": "💬 Discord (Employer)",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "🚨 Is System Alert?": {
            "main": [
                [
                    {
                        "node": "💬 Discord (System Alert)",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}