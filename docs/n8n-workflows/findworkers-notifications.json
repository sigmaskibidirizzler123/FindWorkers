            ]
        },
        "🚨 Is System Alert?": {
            "main": [
                [
                    {
                        "node": "📝 Format System Alert",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "📝 Format Application Alert": {
            "main": [
                [
                    {
                        "node": "📱 Telegram (Application)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "📝 Format Employer Alert": {
            "main": [
                [
                    {
                        "node": "📱 Telegram (Employer)",
                        "type": "main",
