// FindWorkers - Job Marketplace for Phú Quốc
// Production Schema v4 - Simplified for blue-collar market

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobType {
  FULLTIME
  PARTTIME
  CONTRACT
  SEASONAL
  SHIFT
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
  FLEXIBLE
}

enum NotificationType {
  APPLICATION_NEW
  APPLICATION_STATUS
  JOB_MATCH
  JOB_EXPIRING
  INTERVIEW_SCHEDULED
  SYSTEM
  REMINDER
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  phone               String?   @unique
  password            String
  role                UserRole  @default(CANDIDATE)
  isActive            Boolean   @default(true)
  isVerified          Boolean   @default(false)
  avatarUrl           String?
  lastLoginAt         DateTime?
  lastLoginIP         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  savedJobs        SavedJob[]
  notifications    Notification[]

  @@index([phone])
  @@index([email])
  @@map("users")
}

// ============================================================
// CANDIDATE — "Tôi là ai & tôi làm được ca nào"
// ============================================================

model CandidateProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  fullName             String
  phone                String
  currentLocation      String?               // Dương Đông, An Thới, etc.
  desiredJob           String?               // Phục vụ, Pha chế, Lễ tân, etc.
  experienceMonths     Int      @default(0)  // Tháng — phù hợp lao động phổ thông
  shifts               String   @default("[]") // JSON: ["MORNING","AFTERNOON"]
  availableImmediately Boolean  @default(false)
  description          String?
  avatarUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([desiredJob])
  @@map("candidate_profiles")
}

// ============================================================
// EMPLOYER — "Tôi là cơ sở nào"
// ============================================================

model EmployerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String                       // Tên quán / khách sạn / resort
  businessType String?                      // Cafe, Nhà hàng, Resort, Khách sạn
  address      String
  location     String                       // Dương Đông, An Thới, Gành Dầu...
  phone        String
  description  String?
  logoUrl        String?
  companyImages  String?                    // JSON: ["url1","url2",...] max 5 images
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs     Job[]
  branches CompanyBranch[]

  @@index([location])
  @@map("employer_profiles")
}

// ============================================================
// COMPANY BRANCHES (Multi-location support)
// ============================================================

model CompanyBranch {
  id           String   @id @default(cuid())
  employerId   String
  name         String
  address      String
  phone        String?
  managerName  String?
  managerPhone String?
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@map("company_branches")
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  icon     String?

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  jobs      Job[]
  templates JobTemplate[]

  @@index([parentId])
  @@map("categories")
}

// ============================================================
// JOB TEMPLATES
// ============================================================

model JobTemplate {
  id               String   @id @default(cuid())
  categoryId       String?
  category         String   // FNB, HOTEL, RETAIL, etc.
  title            String
  description      String
  requirements     String
  benefits         String
  defaultSalaryMin Int?
  defaultSalaryMax Int?
  suggestedShifts  String?  // JSON: ["MORNING","AFTERNOON"]
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryRef Category? @relation(fields: [categoryId], references: [id])

  @@index([category])
  @@index([categoryId])
  @@index([isActive])
  @@map("job_templates")
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id                  String    @id @default(cuid())
  employerId          String
  categoryId          String?
  title               String
  description         String
  requirements        String?
  benefits            String?
  salaryMin           Int?
  salaryMax           Int?
  salaryNegotiable    Boolean   @default(false)
  location            String
  district            String?
  city                String?
  jobType             JobType   @default(FULLTIME)
  shift               Shift?
  shifts              String    @default("[]")  // JSON: ["MORNING","AFTERNOON"]
  experienceRequired  Int       @default(0)
  genderRequirement   String?
  positions           Int       @default(1)
  hiredCount          Int       @default(0)
  isUrgent            Boolean   @default(false)
  isFeatured          Boolean   @default(false)
  status              JobStatus @default(ACTIVE)
  viewCount           Int       @default(0)
  expiresAt           DateTime?
  autoCloseWhenFull   Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employer           EmployerProfile    @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category           Category?          @relation(fields: [categoryId], references: [id])
  applications       Application[]
  quickApplications  QuickApplication[]
  savedBy            SavedJob[]
  skills             JobSkill[]
  screeningQuestions ScreeningQuestion[]

  @@index([status])
  @@index([categoryId])
  @@index([city])
  @@index([employerId, status])
  @@index([status, isUrgent])
  @@index([status, isFeatured])
  @@index([createdAt])
  @@map("jobs")
}

// ============================================================
// QUICK APPLICATIONS (public — no login required)
// ============================================================

model QuickApplication {
  id           String   @id @default(cuid())
  jobId        String
  fullName     String
  phone        String
  email        String
  cccd         String
  cccdImageUrl String?                     // Front ID card photo
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approveToken String?  @unique           // Secure token for email approval
  createdAt    DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("quick_applications")
}

// ============================================================
// SKILLS (for Jobs only — candidates don't need skills list)
// ============================================================

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  jobs JobSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id            String            @id @default(cuid())
  jobId         String
  candidateId   String
  coverLetter   String?
  status        ApplicationStatus @default(APPLIED)
  matchingScore Int?
  note          String?
  reviewedAt    DateTime?
  interviewDate DateTime?
  interviewNote String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job              Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  screeningAnswers ScreeningAnswer[]

  @@unique([jobId, candidateId])
  @@index([jobId, status])
  @@index([candidateId, status])
  @@index([matchingScore])
  @@index([appliedAt])
  @@map("applications")
}

// ============================================================
// SCREENING QUESTIONS
// ============================================================

model ScreeningQuestion {
  id        String  @id @default(cuid())
  jobId     String
  question  String
  isRequired Boolean @default(true)
  sortOrder Int     @default(0)

  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ScreeningAnswer[]

  @@map("screening_questions")
}

model ScreeningAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answer        String

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@map("screening_answers")
}

// ============================================================
// SAVED JOBS
// ============================================================

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================
// FEATURE FLAGS
// ============================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ============================================================
// ACTIVITY LOG
// ============================================================

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}
